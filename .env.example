# Base mainnet RPC endpoint for server-side reads.
#
# Optional. Unset, reads go to the public endpoints in lib/rpc.ts, which start
# returning "over rate limit" after roughly a dozen calls in quick succession —
# fine locally, thin for a deployment. Any provider works: Coinbase Developer
# Platform, Alchemy, QuickNode.
#
# Server-only, and deliberately not NEXT_PUBLIC_. The URL carries its key, and a
# NEXT_PUBLIC_ variable is inlined into the JavaScript every visitor downloads.
# lib/rpc.ts puts this first and keeps the three public endpoints as fallbacks
# behind it. lib/wagmi.ts stays on a public endpoint on purpose: those reads come
# from each user's own browser rather than from one server, so they do not
# concentrate into a rate limit the way the /markets feed read does.
#
# npm run verify:* loads this file (verify/env.ts), so the live checks read
# through the same endpoint the app does rather than reporting on public ones.
BASE_RPC_URL=

# KyberSwap aggregator client id, sent as the x-client-id header.
#
# Optional. Rate-limit attribution rather than a credential, which is why
# lib/quote.ts falls back to "bourse" when it is unset. Deliberately not
# NEXT_PUBLIC_: quotes are fetched through /api/quote so this stays on the server.
KYBERSWAP_CLIENT_ID=

# Where a Bourse fee would be paid, if there were one.
#
# Leave unset. BOURSE_FEE_BPS in lib/quote.ts is 0, so no fee parameters are
# attached to a route request at all and this value is never read. It exists as a
# variable rather than a constant because no payout address belongs in the repo,
# and because turning a fee on should be a deployment decision rather than a code
# change plus a redeploy.
#
# If it is ever set: bourseFeeParams refuses to build fee parameters without it, so
# a non-zero BOURSE_FEE_BPS with this empty is a misconfiguration the quote path
# reports rather than silently ignores.
BOURSE_FEE_RECEIVER=
