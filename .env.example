# Base mainnet RPC endpoint.
#
# Optional. When unset the app falls back to the public endpoint
# (https://mainnet.base.org), which is rate limited and will drop multicall
# traffic under load. Use a dedicated endpoint — Coinbase Developer Platform,
# Alchemy or QuickNode — for anything beyond local development.
#
# NEXT_PUBLIC_ is required: the browser signs and sends its own transactions,
# so this URL is public by design. Never put a secret in a NEXT_PUBLIC_ var.
NEXT_PUBLIC_BASE_RPC_URL=

# KyberSwap aggregator client id, sent as the x-client-id header.
#
# Optional. Rate-limit attribution rather than a credential, which is why
# lib/quote.ts falls back to "bourse" when it is unset. Deliberately not
# NEXT_PUBLIC_: quotes are fetched through /api/quote so this stays on the server.
KYBERSWAP_CLIENT_ID=

# Where a Bourse fee would be paid, if there were one.
#
# Leave unset. BOURSE_FEE_BPS in lib/quote.ts is 0, so no fee parameters are
# attached to a route request at all and this value is never read. It exists as a
# variable rather than a constant because no payout address belongs in the repo,
# and because turning a fee on should be a deployment decision rather than a code
# change plus a redeploy.
#
# If it is ever set: bourseFeeParams refuses to build fee parameters without it, so
# a non-zero BOURSE_FEE_BPS with this empty is a misconfiguration the quote path
# reports rather than silently ignores.
BOURSE_FEE_RECEIVER=
