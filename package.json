{
  "name": "bourse",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "vitest run --config vitest.verify.config.ts",
    "verify:build": "vitest run --config vitest.verify.config.ts verify/build.verify.ts",
    "verify:chain": "vitest run --config vitest.verify.config.ts verify/chain.verify.ts",
    "verify:quote": "vitest run --config vitest.verify.config.ts verify/quote.verify.ts",
    "verify:simulate": "vitest run --config vitest.verify.config.ts verify/simulate.verify.ts",
    "verify:sell-quote": "vitest run --config vitest.verify.config.ts verify/sell-quote.verify.ts",
    "verify:sell-simulate": "vitest run --config vitest.verify.config.ts verify/sell-simulate.verify.ts",
    "verify:multiplier": "vitest run --config vitest.verify.config.ts verify/multiplier.verify.ts"
  },
  "dependencies": {
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tailwindcss/postcss": "^4.3.3",
    "@tanstack/react-query": "^5.62.0",
    "lucide-react": "^1.42.0",
    "next": "^15.1.0",
    "next-themes": "^0.4.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sonner": "^2.0.8",
    "tailwindcss": "^4.3.3",
    "viem": "^2.21.0",
    "wagmi": "^2.14.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
