{
  "name": "bourse",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "vitest run --config vitest.verify.config.ts",
    "verify:build": "vitest run --config vitest.verify.config.ts verify/build.verify.ts",
    "verify:chain": "vitest run --config vitest.verify.config.ts verify/chain.verify.ts",
    "verify:quote": "vitest run --config vitest.verify.config.ts verify/quote.verify.ts",
    "verify:simulate": "vitest run --config vitest.verify.config.ts verify/simulate.verify.ts"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.62.0",
    "next": "^15.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "viem": "^2.21.0",
    "wagmi": "^2.14.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
